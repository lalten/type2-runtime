load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "runtime",
    srcs = ["runtime.c"],
    additional_linker_inputs = ["data_sections.ld"],
    linkopts = ["-T$(rootpath data_sections.ld)"],
    local_defines = [
        "FUSE_USE_VERSION=316",
        "GIT_COMMIT=\\\"" + module_version() + "\\\"",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@libfuse",
        "@squashfuse",
        "@zlib",
        "@zstd",
    ],
)
