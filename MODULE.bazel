module(name = "type2-runtime")

bazel_dep(name = "bazel_lib", version = "3.7.0")

# Stay on 3.16.2: libfuse 3.17+ depends on liburing, whose configure script is
# run by a genrule that probes the host instead of the hermetic target, so it
# emits a compat.h that clashes with the toolchain's libc headers.
bazel_dep(name = "libfuse", version = "3.16.2")
bazel_dep(name = "llvm", version = "0.8.16")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "squashfuse", version = "0.5.2")
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")

register_toolchains("@llvm//toolchain:all")
